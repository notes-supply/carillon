[Unit]
Description=Carillon Discord interface provider
After=network-online.target carillon-core.service
Wants=network-online.target
PartOf=carillon.target

[Service]
Type=simple
WorkingDirectory=@OWNER_HOME@
Environment="HOME=@OWNER_HOME@"
Environment="USER=@OWNER@"
Environment="LOGNAME=@OWNER@"
Environment="SHELL=@OWNER_SHELL@"
Environment="PATH=@OWNER_PATH@"
Environment="CARILLON_HOME=@CARILLON_HOME@"
Environment="PI_CODING_AGENT_DIR=@CARILLON_HOME@/pi"
ExecStart="@CARILLON_HOME@/app/bin/carillon" discord serve --config "@CARILLON_HOME@/carillon.toml" --provider discord-private --token-file "@CARILLON_HOME@/credentials/discord-private.token" --discord-token-file "@CARILLON_HOME@/credentials/discord-bot.token" --commands "@CARILLON_HOME@/app/lib/carillon_discord_commands.wasm"
Restart=on-failure
RestartSec=2s
UMask=0077
StandardOutput=append:@CARILLON_HOME@/logs/discord.log
StandardError=append:@CARILLON_HOME@/logs/discord.log

[Install]
WantedBy=carillon.target
