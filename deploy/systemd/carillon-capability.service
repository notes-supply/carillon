[Unit]
Description=Carillon example external capability
After=network.target

[Service]
Type=simple
User=carillon-capability
Group=carillon-capability
SupplementaryGroups=carillon
LoadCredential=component-token:/var/lib/carillon/credentials/echo-capability.token
ExecStart=/opt/carillon/bin/carillon capability --config /var/lib/carillon/carillon.toml --token-file %d/component-token
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/carillon/state/components/echo-capability

[Install]
WantedBy=multi-user.target
