[Unit]
Description=Carillon durable composition core
After=network.target

[Service]
Type=simple
User=carillon-core
Group=carillon-core
SupplementaryGroups=carillon
ExecStart=/opt/carillon/bin/carillon core --config /var/lib/carillon/carillon.toml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/carillon/state

[Install]
WantedBy=multi-user.target
