[Unit]
Description=Carillon Pi runtime adapter
After=network-online.target
Wants=network-online.target
PartOf=carillon.target

[Service]
Type=simple
WorkingDirectory=@OWNER_HOME@
Environment="HOME=@OWNER_HOME@"
Environment="USER=@OWNER@"
Environment="LOGNAME=@OWNER@"
Environment="SHELL=@OWNER_SHELL@"
Environment="PATH=@OWNER_PATH@"
Environment="CARILLON_HOME=@CARILLON_HOME@"
Environment="PI_CODING_AGENT_DIR=@CARILLON_HOME@/pi"
ExecStart="@CARILLON_HOME@/app/bin/carillon-runtime-pi" --config "@CARILLON_HOME@/carillon.toml" --provider runtime-pi --token-file "@CARILLON_HOME@/credentials/runtime-pi.token" --state-dir "@CARILLON_HOME@/pi"
Restart=on-failure
RestartSec=2s
UMask=0077
StandardOutput=append:@CARILLON_HOME@/logs/runtime-pi.log
StandardError=append:@CARILLON_HOME@/logs/runtime-pi.log

[Install]
WantedBy=carillon.target
