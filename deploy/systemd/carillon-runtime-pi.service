[Unit]
Description=Carillon Pi runtime adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carillon-runtime
Group=carillon-runtime
SupplementaryGroups=carillon
LoadCredential=component-token:/var/lib/carillon/credentials/runtime-pi.token
ExecStart=/opt/carillon/bin/carillon-runtime-pi --config /var/lib/carillon/carillon.toml --token-file %d/component-token --state-dir /var/lib/pi-carillon
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
StateDirectory=pi-carillon
StateDirectoryMode=0700
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/carillon/state/components/runtime-pi /var/lib/carillon/agents/default/sessions

[Install]
WantedBy=multi-user.target
