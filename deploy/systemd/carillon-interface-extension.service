[Unit]
Description=Carillon example guild command extension
After=network.target
PartOf=carillon.target

[Service]
Type=simple
WorkingDirectory=@OWNER_HOME@
Environment="HOME=@OWNER_HOME@"
Environment="USER=@OWNER@"
Environment="LOGNAME=@OWNER@"
Environment="SHELL=@OWNER_SHELL@"
Environment="PATH=@OWNER_PATH@"
Environment="CARILLON_HOME=@CARILLON_HOME@"
Environment="PI_CODING_AGENT_DIR=@CARILLON_HOME@/pi"
ExecStart="@CARILLON_HOME@/app/bin/carillon" interface-extension --config "@CARILLON_HOME@/carillon.toml" --token-file "@CARILLON_HOME@/credentials/guild-command.token"
Restart=on-failure
RestartSec=2s
UMask=0077
StandardOutput=append:@CARILLON_HOME@/logs/interface-extension.log
StandardError=append:@CARILLON_HOME@/logs/interface-extension.log

[Install]
WantedBy=carillon.target
