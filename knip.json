{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["strace", "unshare"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "crates/carillon-web/site/app.js"]
    },
    "packages/runtime-pi": {
      "entry": ["src/crash-worker.ts"]
    },
    "packages/web": {
      "entry": ["src/api/stream.ts", "src/api/requests.ts", "src/activity/ledger.ts"],
      "project": ["src/**"]
    }
  }
}
