{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["strace", "unshare"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/runtime-pi": {
      "entry": ["src/crash-worker.ts"]
    },
    "packages/web": {
      "entry": ["fake/main.ts"],
      "project": ["src/**", "fake/**", "browser/**"],
      "playwright": {
        "config": ["browser/playwright.config.ts"],
        "entry": ["browser/*.spec.ts"]
      }
    }
  }
}
